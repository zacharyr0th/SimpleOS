{
  "name": "simpleos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": "24.x"
  },
  "workspaces": ["web"],
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "prepare:web-assets": "bash scripts/prepare-web-assets.sh",
    "lint": "bun run --cwd web lint",
    "lint:fix": "bun run --cwd web lint:fix",
    "format": "bun run --cwd web format",
    "typecheck": "bun run --cwd web typecheck",
    "test": "python3 verify_os.py",
    "test:unit": "bun run test",
    "test:e2e": "bun run test:kernel",
    "test:kernel": "make kernel.bin && bash scripts/check-kernel-isa.sh && bash scripts/smoke-test.sh 12 && bash scripts/selftest.sh 15",
    "validate": "bun run lint && bun run typecheck && bun run test:unit",
    "validate:full": "bun run validate && bun run build && bun run test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@raintree-technology/trellis": "0.3.0"
  }
}
